# Copie para .env.local (nunca commitado) e preencha com os valores reais.
# Nenhuma dessas variáveis deve ter o prefixo NEXT_PUBLIC_ — todas são lidas
# apenas em código server-only (Server Action / RSC), nunca no client.

# Supabase — projeto "Gabriel-serra-eng's Project" (id: xhntobdbpzsvfblmihnf)
# URL da API do projeto.
SUPABASE_URL=https://xhntobdbpzsvfblmihnf.supabase.co
# Chave "anon" (legacy JWT). Só tem permissão de INSERT na tabela `leads` via RLS
# (ver migration 0001_create_leads_table) — mesmo que vaze, não lê nem altera dados.
SUPABASE_ANON_KEY=
