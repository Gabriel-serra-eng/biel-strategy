# Copie para .env.local (nunca commitado) e preencha com os valores reais.
# Nenhuma dessas variáveis deve ter o prefixo NEXT_PUBLIC_ — todas são lidas
# apenas em código server-only (Server Action / RSC), nunca no client.

# Supabase — projeto do Biel Strategy no Supabase.
# URL da API do projeto (Project Settings > API > Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co
# Chave "anon" (Project Settings > API > anon public). Só tem permissão de
# INSERT na tabela `leads` via RLS (ver migration 0001_create_leads_table)
# — mesmo que vaze, não lê nem altera dados.
SUPABASE_ANON_KEY=your-anon-key-here
